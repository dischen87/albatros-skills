{
  "mcpServers": {
    "albatros": {
      "type": "http",
      "url": "https://mcp.albatros.build",
      "headers": {
        "X-Albatros-Skills-Stand": "0.3.2"
      },
      "http_headers": {
        "X-Albatros-Skills-Stand": "0.3.2"
      }
    },
    "albatros-arbeitsplatz": {
      "type": "stdio",
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/arbeitsplatz/arbeitsplatz.mjs", "--mcp"]
    }
  }
}
