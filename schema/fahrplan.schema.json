{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://albatros.build/schema/fahrplan.schema.json",
  "title": "Albatros-Fahrplan",
  "description": "fahrplan.yaml: der feste Ablauf von Albatros (Phasen, Skills und Abschnitte, Ergebnisse, Pflichtfragen, Ja-Momente, Marken, Wohnorte, Insel-Schritte). Was ein Schema nicht prüfen kann (eindeutige Kennungen, Insel deckungsgleich mit den Phasen, die zehn alten Schlüssel, Ja-Momente auf Pflichtfragen der Person, Fragen je Phase, Skills und Methoden vorhanden), prüft scripts/pruefen.ts; Insel je Wohnort und Marken prüft scripts/fahrplan.ts beim Laden.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "stand", "gratis_bis", "fragen_je_phase", "fragen_je_nachricht", "ja_momente", "marken", "wohnorte", "modus", "bauen_lassen", "phasen", "nach_live", "insel"],
  "properties": {
    "version": { "description": "Fassung des Vertrags.", "type": "integer", "minimum": 1 },
    "stand": { "description": "Datum der Fassung.", "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "gratis_bis": {
      "description": "Letzte Phase, die ohne Abo geht; muss mit GRATIS.bisPhase in albatros/services/konto/src/stufen.ts übereinstimmen.",
      "$ref": "#/$defs/phase"
    },
    "fragen_je_phase": { "description": "Höchstens so viele Pflichtfragen mit antwortet: person je Phase.", "type": "integer", "minimum": 1 },
    "fragen_je_nachricht": { "description": "Höchstens so viele Fragen in einer Nachricht.", "type": "integer", "minimum": 1 },
    "ja_momente": {
      "description": "Die Freigaben: je eine Pflichtfrage mit antwortet: person in dieser Phase.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phase", "frage"],
        "properties": { "phase": { "$ref": "#/$defs/phase" }, "frage": { "$ref": "#/$defs/kennung" } }
      }
    },
    "marken": {
      "description": "Marken am Anfang eines Werts, ohne Gross- und Kleinschreibung; offen und platzhalter: die Zeile ist nicht belegt; annahme: belegt, aber keine Antwort der Person.",
      "type": "object",
      "additionalProperties": false,
      "required": ["offen", "platzhalter", "annahme"],
      "properties": {
        "offen": { "$ref": "#/$defs/woerter" },
        "platzhalter": { "$ref": "#/$defs/woerter" },
        "annahme": { "$ref": "#/$defs/woerter" }
      }
    },
    "wohnorte": {
      "description": "Wohnorte bei Albatros: Anfang des Werts der Zeile «Wohnort:» (P11); jeder andere belegte Wert heisst selbst.",
      "type": "object",
      "additionalProperties": false,
      "required": ["light", "pilot"],
      "properties": { "light": { "$ref": "#/$defs/text" }, "pilot": { "$ref": "#/$defs/text" } }
    },
    "modus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["standard", "quelle", "machen", "lernen"],
      "properties": {
        "standard": { "enum": ["machen", "lernen"] },
        "quelle": { "$ref": "#/$defs/ablage" },
        "machen": { "$ref": "#/$defs/text" },
        "lernen": { "$ref": "#/$defs/text" }
      }
    },
    "bauen_lassen": {
      "description": "Bauservice (01.11.2026): Ab dieser Phase bietet lage einmal an, dass Albatros baut (nur mit Schalter BAUSERVICE, im Modus nur_modus, wenn die Zeile «Setup:» in docs/plan.md mit setup_beginnt anfängt, ohne Auftrag und ohne die Zeile aus quelle). Die Wahl der Person steht in quelle und beginnt mit einem der werte (deutsch in allen Sprachen), danach das Datum. Die Texte, die lage dazu sagt, stehen in albatros, nicht hier.",
      "type": "object",
      "additionalProperties": false,
      "required": ["ab", "quelle", "werte", "nur_modus", "setup_beginnt"],
      "properties": {
        "ab": { "$ref": "#/$defs/phase" },
        "quelle": { "$ref": "#/$defs/ablage" },
        "werte": { "$ref": "#/$defs/woerter" },
        "nur_modus": { "enum": ["machen", "lernen"] },
        "setup_beginnt": { "type": "string", "pattern": "^[a-zäöü]+$" }
      }
    },
    "phasen": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/phase_eintrag" } },
    "nach_live": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aendern", "landen"],
      "properties": {
        "aendern": {
          "type": "object",
          "additionalProperties": false,
          "required": ["skill", "klein", "gross"],
          "properties": {
            "skill": { "$ref": "#/$defs/kennung" },
            "klein": { "$ref": "#/$defs/texte" },
            "gross": { "$ref": "#/$defs/texte" }
          }
        },
        "landen": { "$ref": "#/$defs/je_weg" }
      }
    },
    "insel": {
      "description": "Alle Insel-Schritte in ihrer Reihenfolge; genau die Schritte aus phasen[].insel, in derselben Reihenfolge.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/kennung" }
    }
  },
  "$defs": {
    "phase": { "type": "string", "pattern": "^P[1-9][0-9]?$" },
    "kennung": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "text": { "type": "string", "pattern": "\\S" },
    "texte": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } },
    "woerter": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^\\S(.*\\S)?$" } },
    "ablage": {
      "description": "Datei im Projekt der Person, optional mit #Zeilenanfang (z. B. docs/projekt.md#Projektname:).",
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*(#[^#]*\\S)?$"
    },
    "sprachen": {
      "description": "Derselbe Inhalt in allen vier Sprachen (Du-Form: du, tu, tu, you); die KI formuliert in ihren Worten.",
      "type": "object",
      "additionalProperties": false,
      "required": ["de", "fr", "it", "en"],
      "properties": {
        "de": { "$ref": "#/$defs/text" },
        "fr": { "$ref": "#/$defs/text" },
        "it": { "$ref": "#/$defs/text" },
        "en": { "$ref": "#/$defs/text" }
      }
    },
    "methoden": {
      "description": "Methoden des Wegs Geschäft (privates Repo albatros-methoden) und ob sie vor oder nach den Schritten des Skills kommen.",
      "type": "object",
      "additionalProperties": false,
      "required": ["geschaeft", "wann"],
      "properties": {
        "geschaeft": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/kennung" } },
        "wann": { "enum": ["vor_skill", "nach_skill"] }
      }
    },
    "ausgaenge": {
      "description": "Wie die Phase auf dem Weg Geschäft enden kann, mit welchen dieser Ausgänge sie geschafft ist (die übrigen halten sie, solange eine Methode der Phase zur Stufe gehört), und die Zeile, in der die Methode der Phase den Ausgang festhält.",
      "type": "object",
      "additionalProperties": false,
      "required": ["geschaeft", "geschafft", "ablage"],
      "properties": {
        "geschaeft": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/kennung" } },
        "geschafft": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/kennung" } },
        "ablage": { "$ref": "#/$defs/ablage" }
      }
    },
    "je_weg": {
      "description": "Zusätzliche Methoden des Wegs Geschäft (privates Repo albatros-methoden).",
      "type": "object",
      "additionalProperties": false,
      "properties": { "geschaeft": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/kennung" } } }
    },
    "pflichtfrage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "bereich", "antwortet", "ablage", "frage", "warum"],
      "properties": {
        "id": { "description": "Eindeutig über alle Phasen.", "$ref": "#/$defs/kennung" },
        "bereich": { "enum": ["ablauf", "struktur", "design", "setup", "testing", "release"] },
        "antwortet": {
          "description": "person: immer die Person, auch im Modus machen; annahme_ok: die KI schlägt einen Standard als [Annahme] vor; ki: die KI klärt es selbst und zeigt das Ergebnis.",
          "enum": ["person", "annahme_ok", "ki"]
        },
        "ablage": { "$ref": "#/$defs/ablage" },
        "werte": {
          "description": "Der Wert beginnt mit einem dieser Wörter (deutsch in allen Sprachen); danach darf ein Satz in der Sprache der Person folgen.",
          "$ref": "#/$defs/woerter"
        },
        "frage": { "$ref": "#/$defs/sprachen" },
        "warum": { "$ref": "#/$defs/sprachen" }
      }
    },
    "ergebnis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["datei"],
      "properties": {
        "datei": { "type": "string", "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$" },
        "zeilen": {
          "description": "Pflichtzeilen: Zeilenanfänge, die in der Datei stehen müssen.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "\\S:$" }
        }
      }
    },
    "variante": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "skill": { "$ref": "#/$defs/kennung" },
        "abschnitt": { "$ref": "#/$defs/text" },
        "zusatz": { "$ref": "#/$defs/text" }
      }
    },
    "phase_eintrag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "titel", "etappe", "bild", "skill", "ergebnis", "insel", "pflichtfragen", "gate"],
      "properties": {
        "id": { "$ref": "#/$defs/phase" },
        "titel": { "$ref": "#/$defs/text" },
        "etappe": { "enum": ["abheben", "fliegen", "landen"] },
        "bild": { "$ref": "#/$defs/text" },
        "skill": { "description": "Skill in plugins/albatros/skills/<skill>.", "$ref": "#/$defs/kennung" },
        "abschnitt": { "description": "Abschnitt des Skills; fehlt er, gilt der ganze Skill.", "$ref": "#/$defs/text" },
        "methoden": { "$ref": "#/$defs/methoden" },
        "varianten": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "modernisieren": { "$ref": "#/$defs/variante" } }
        },
        "ergebnis": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ergebnis" } },
        "insel": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/kennung" } },
        "insel_je_wohnort": {
          "description": "Insel-Schritte, die die KI je Wohnort (P11) bis zum Abschluss meldet; je eine Teilfolge von insel.",
          "type": "object",
          "additionalProperties": false,
          "required": ["light", "pilot", "selbst"],
          "properties": {
            "light": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/kennung" } },
            "pilot": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/kennung" } },
            "selbst": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/kennung" } }
          }
        },
        "lernmomente": { "$ref": "#/$defs/texte" },
        "ausgaenge": { "$ref": "#/$defs/ausgaenge" },
        "pflichtfragen": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/pflichtfrage" } },
        "pruefliste": { "description": "Jeder Punkt: ok, Risiko oder offen, mit Stelle im Plan.", "$ref": "#/$defs/texte" },
        "zweite_meinung": {
          "description": "Wie die zweite Meinung in frischem Kontext je KI entsteht.",
          "type": "object",
          "additionalProperties": false,
          "required": ["claude-code", "codex", "gemini-cli", "cursor"],
          "properties": {
            "claude-code": { "$ref": "#/$defs/text" },
            "codex": { "$ref": "#/$defs/text" },
            "gemini-cli": { "$ref": "#/$defs/text" },
            "cursor": { "$ref": "#/$defs/text" }
          }
        },
        "gate": { "description": "Was stimmen muss, bevor die nächste Phase beginnt.", "$ref": "#/$defs/text" }
      }
    }
  }
}
